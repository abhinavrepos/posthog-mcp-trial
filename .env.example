# Every setting PostHog Lens reads. Copy this file to .secrets.env (git-ignored) and fill it in, or put
# it anywhere and point TRIAGE_ENV_FILE at it. Real environment variables win over the file.
# Check a filled-in file with:  pnpm doctor
# Empty values mean "not set": the default in brackets applies.

# ------------------------------------------------------------------ PostHog
# Where this service reaches the PostHog API (from the machine it runs on).        [http://localhost]
POSTHOG_HOST=https://posthog.example.com
# Where people's browsers reach PostHog; replay links in reports use it.            [POSTHOG_HOST]
POSTHOG_PUBLIC_HOST=
# The project (Settings → Project → Project ID) and its public token (phc_…).
POSTHOG_PROJECT_ID=
POSTHOG_PROJECT_TOKEN=
# A personal API key (phx_…) scoped to that one project, read-only, with: query:read,
# session_recording:read (to render clips; Claude never sees them), error_tracking:read,
# person:read, group:read, project:read. pnpm doctor checks the scopes.
POSTHOG_PERSONAL_API_KEY=
# Only for scripts/setup-posthog.sh and the load test. The service never uses them.
POSTHOG_ADMIN_EMAIL=
POSTHOG_ADMIN_PASSWORD=

# How your events name things. Plain property names only.
PROP_CLIENT_ID=client_id          # event property with the client (customer account) id
PROP_CLIENT_NAME=client_name      # event property with the client's display name. none: show the client id
PROP_APP_VERSION=app_version      # event property with the release, e.g. 26.10.0. none: match by date only
PROP_PERSON_EMAIL=email           # person property with the user's email
# When the client is part of the user id instead of a property, e.g. Reval's ENV|SITE|CLIENT|USER:
# which part (1 = first) and the separator. 0: use PROP_CLIENT_ID. Reval: 3 and |.
CLIENT_FROM_DISTINCT_ID=0
DISTINCT_ID_SEPARATOR=|

# Your app's own events (dialogs, buttons, messages), so the MCP tools describe_app_events,
# session_story and dialog_friction can read them. JSON file; Reval: config/app-events.reval.json.
APP_EVENTS_FILE=

# Your app's screens, so a ticket that says "the invoices page" finds /invoices. JSON file, see
# config/screens.example.json. Empty: the demo app's screens.
SCREENS_FILE=

# ------------------------------------------------------------------ Which MCP servers Claude gets
# Two separate switches, on or off. After changing them: pnpm mcp:config (rewrites .mcp.json for
# Claude Code) and scripts/stack.sh restart service (for /mcp over HTTP).
# This service's tools: replay links, tickets, clients, screens, releases.                    [on]
#   off: /mcp answers 503, the stdio server exits, .mcp.json leaves it out.
FEATURE_LENS_MCP=on
# Client/server name: 1-64 lowercase letters, digits or hyphens. posthog is reserved.           [lens]
LENS_MCP_NAME=lens
# PostHog's own MCP server (SQL, insights, flags, surveys…). Needs POSTHOG_MCP_URL and its key. [on]
#   off: .mcp.json leaves it out, and the instructions stop sending Claude to it. The rule that
#   Claude never opens replays stays either way.
FEATURE_POSTHOG_MCP=on

# ------------------------------------------------------------------ PostHog's own MCP server (optional)
# Gives Claude PostHog's tools too (SQL, insights, flags, surveys…). pnpm mcp:config writes both
# servers into .mcp.json, with replay tools left out. https://mcp.posthog.com/mcp for PostHog Cloud,
# or your own copy of PostHog's services/mcp for a self-hosted PostHog.
POSTHOG_MCP_URL=
# A separate personal key for it, WITHOUT session_recording:read, so replays stay out of reach.
POSTHOG_MCP_API_KEY=
# Route PostHog through /posthog-mcp when LENS_CONTAINER=1 or MCP_TOKEN is set.                 [on]
# Adds Lens routing rules, refuses replay commands and keeps PostHog's key out of clients.
# off: connect directly to POSTHOG_MCP_URL with POSTHOG_MCP_API_KEY.
POSTHOG_MCP_VIA_LENS=on

# ------------------------------------------------------------------ Surveys (optional)
# In-app surveys for the tracked app's users, made and watched from Lens (MCP tools and the Surveys page).
# They are PostHog surveys shown by PostHog's own survey script, with Lens condition chains
# (deploy/posthog/survey-engine). The installer makes this key: survey read and write, this project only.
POSTHOG_SURVEY_API_KEY=
# off: no survey tools and no Surveys page.                                                     [on]
FEATURE_SURVEYS=on
# A user is in at most this many running surveys at once; later ones wait until they finish one.   [2]
SURVEYS_PER_USER=2
# Never two surveys within this many hours for a user (24 at least).                              [24]
SURVEYS_MIN_GAP_HOURS=24
# After a user closes a survey with the cross: no survey for them for this many days.              [7]
SURVEYS_QUIET_DAYS_AFTER_CLOSE=7

# ------------------------------------------------------------------ Jira (optional until connected)
# All three empty: Jira is off. Webhooks answer 503, release outcomes keep their last numbers, and
# pnpm doctor warns. Everything else works.
JIRA_BASE_URL=                    # https://your-site.atlassian.net
JIRA_EMAIL=                       # the bot user's login
JIRA_API_TOKEN=                   # https://id.atlassian.com/manage-profile/security/api-tokens
# The secret of the "Issue created" webhook pointing at https://<service>/webhooks/jira. Required:
# without it every webhook is rejected.
JIRA_WEBHOOK_SECRET=
# Issue types that get triaged.                                                      [RCI, MMT Risk]
JIRA_RCI_ISSUE_TYPE=RCI
JIRA_RISK_ISSUE_TYPE=MMT Risk
# Optional custom fields (for example customfield_10042). Unset fields are read from the ticket text.
JIRA_FIELD_CLIENT=
JIRA_FIELD_USER_EMAIL=
JIRA_FIELD_SCREEN=
JIRA_FIELD_OCCURRED_AT=
# Where ticket links in answers open.                                               [JIRA_BASE_URL]
JIRA_PUBLIC_URL=

# ------------------------------------------------------------------ Release outcomes
RELEASES_JIRA_PROJECT=ACP                                   # project whose fix versions are the releases
RELEASES_SUPPORT_JQL=project = SUP AND issuetype in ("RCI", "MMT Risk")
RELEASES_KEEP=12                                            # releases kept (1–52)
RELEASES_WINDOW_DAYS=30                                     # longest "after" window (7–120)
RELEASES_FISCAL_START_MONTH=1                               # 1 = calendar quarters, 4 = April, …
RELEASES_COMPONENT_SCREENS={}                               # Jira component → screen, e.g. {"Billing": "/invoices"}

# ------------------------------------------------------------------ This service
SERVICE_PORT=8080
# The address people use to open clip links (put HTTPS in front for anything public).
SERVICE_PUBLIC_URL=http://localhost:8080
# The System page in PostHog Lens reads the status page here (deploy/status). STATUS_PASSWORD only if
# that page has one.
STATUS_URL=http://127.0.0.1:8090
STATUS_PASSWORD=
# Bearer token for /mcp and /status. Long and random: openssl rand -hex 32
MCP_TOKEN=
# Signs clip links. Long and random.
CLIP_LINK_SECRET=
CLIP_LINK_TTL_HOURS=168
APP_NAME=PostHog Lens
APP_TAG=for ION
# SQLite file for clips, people, releases and verdicts.                            [run/triage.db]
TRIAGE_DB=

# ------------------------------------------------------------------ Clips
CLIP_RETENTION_DAYS=14            # unsaved clips are deleted after this
CLIPS_PER_HOUR=20                 # per person
AUDIT_RETENTION_DAYS=365
CLIP_OUT_DIR=                     # [clips/]
CLIP_CACHE_DIR=                   # [.cache/]
CLIP_CACHE_MAX_MB=2048
# Hosts a recording may load while it renders. Everything else fails to resolve.  [localhost]
CLIP_ALLOWED_HOSTS=localhost
CHROME_HEADLESS_SHELL=            # path to chrome-headless-shell; empty uses the one pnpm install fetched

# ------------------------------------------------------------------ Live page
LIVE_ACTIVE_GAP_S=60              # after each action, this many seconds count as active (the page can change it)
LIVE_NOW_MINUTES=5                # "in the app now" = an action within this many minutes
# Events that are not a person doing something, so they never count as actions. Comma-separated.
LIVE_IGNORE_EVENTS=$feature_flag_called,$set,$groupidentify,$web_vitals,$opt_in,survey shown,survey dismissed

# ------------------------------------------------------------------ Claude (optional)
# Lets the Jira automation read ticket text with Claude. Without it, rules are used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ------------------------------------------------------------------ Demo only
DEMO_APP_URL=http://localhost:3000
DEMO_APP_PORT=3000
