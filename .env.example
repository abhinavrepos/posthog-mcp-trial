# Every setting PostHog Lens reads. Copy this file to .secrets.env (git-ignored) and fill it in, or put
# it anywhere and point TRIAGE_ENV_FILE at it. Real environment variables win over the file.
# Check a filled-in file with:  pnpm doctor
# Empty values mean "not set": the default in brackets applies.

# ------------------------------------------------------------------ PostHog
# Where this service reaches the PostHog API (from the machine it runs on).        [http://localhost]
POSTHOG_HOST=https://posthog.example.com
# Where people's browsers reach PostHog; replay links in reports use it.            [POSTHOG_HOST]
POSTHOG_PUBLIC_HOST=
# The project (Settings → Project → Project ID) and its public token (phc_…).
POSTHOG_PROJECT_ID=
POSTHOG_PROJECT_TOKEN=
# A personal API key (phx_…) scoped to that one project, read-only, with: query:read,
# session_recording:read (to render clips; Claude never sees them), error_tracking:read,
# person:read, group:read, project:read. pnpm doctor checks the scopes.
POSTHOG_PERSONAL_API_KEY=
# Only for scripts/setup-posthog.sh and the load test. The service never uses them.
POSTHOG_ADMIN_EMAIL=
POSTHOG_ADMIN_PASSWORD=

# How your events name things. Plain property names only.
PROP_CLIENT_ID=client_id          # event property with the client (customer account) id
PROP_CLIENT_NAME=client_name      # event property with the client's display name. none: show the client id
PROP_APP_VERSION=app_version      # event property with the release, e.g. 26.10.0. none: match by date only
PROP_PERSON_EMAIL=email           # person property with the user's email
# When the client is part of the user id instead of a property, e.g. Reval's ENV|SITE|CLIENT|USER:
# which part (1 = first) and the separator. 0: use PROP_CLIENT_ID. Reval: 3 and |.
CLIENT_FROM_DISTINCT_ID=0
DISTINCT_ID_SEPARATOR=|

# Your app's own events (dialogs, buttons, messages), so the MCP tools describe_app_events,
# session_story and dialog_friction can read them. JSON file; Reval: config/app-events.reval.json.
APP_EVENTS_FILE=

# Your app's screens, so a ticket that says "the invoices page" finds /invoices. JSON file, see
# config/screens.example.json. Empty: the demo app's screens.
SCREENS_FILE=

# ------------------------------------------------------------------ Which MCP servers Claude gets
# Two separate switches, on or off. After changing them: pnpm mcp:config (rewrites .mcp.json for
# Claude Code) and scripts/stack.sh restart service (for /mcp over HTTP).
# This service's tools: replay links, tickets, clients, screens, releases.                    [on]
#   off: /mcp answers 503, the stdio server exits, .mcp.json leaves it out.
FEATURE_LENS_MCP=on
# Client/server name: 1-64 lowercase letters, digits or hyphens. posthog is reserved.           [lens]
LENS_MCP_NAME=lens
# PostHog's own MCP server (SQL, insights, flags, surveys…). Needs POSTHOG_MCP_URL and its key. [on]
#   off: .mcp.json leaves it out, and the instructions stop sending Claude to it. The rule that
#   Claude never opens replays stays either way.
FEATURE_POSTHOG_MCP=on

# ------------------------------------------------------------------ PostHog's own MCP server (optional)
# Gives Claude PostHog's tools too (SQL, insights, flags, surveys…). pnpm mcp:config writes both
# servers into .mcp.json, with replay tools left out. https://mcp.posthog.com/mcp for PostHog Cloud,
# or your own copy of PostHog's services/mcp for a self-hosted PostHog.
POSTHOG_MCP_URL=
# A separate personal key for it, WITHOUT session_recording:read, so replays stay out of reach.
POSTHOG_MCP_API_KEY=
# Route PostHog through /posthog-mcp when LENS_CONTAINER=1 or MCP_TOKEN is set.                 [on]
# Adds Lens routing rules, refuses replay commands and keeps PostHog's key out of clients.
# off: connect directly to POSTHOG_MCP_URL with POSTHOG_MCP_API_KEY.
POSTHOG_MCP_VIA_LENS=on
# Long analytics commands use posthog_exec jobs (20s handle budget); cheap commands keep 30s.
LENS_POSTHOG_QUERY_TIMEOUT_SECONDS=600
LENS_POSTHOG_MAX_CONCURRENT_QUERIES=3
# FIFO waiting jobs; overflow returns a busy/retry-later error.
LENS_POSTHOG_MAX_QUEUED_QUERIES=30

# ------------------------------------------------------------------ Surveys (optional)
# In-app surveys for the tracked app's users, made and watched from Lens (MCP tools and the Surveys page).
# They are PostHog surveys shown by PostHog's own survey script, with Lens condition chains
# (deploy/posthog/survey-engine). The installer makes this key: survey read and write, this project only.
POSTHOG_SURVEY_API_KEY=
# off: no survey tools and no Surveys page.                                                     [on]
FEATURE_SURVEYS=on
# A user is in at most this many running surveys at once; later ones wait until they finish one.   [2]
SURVEYS_PER_USER=2
# Never two surveys within this many hours for a user (24 at least).                              [24]
SURVEYS_MIN_GAP_HOURS=24
# After a user closes a survey with the cross: no survey for them for this many days.              [7]
SURVEYS_QUIET_DAYS_AFTER_CLOSE=7

# ------------------------------------------------------------------ Jira (off by default)
FEATURE_JIRA=off                   # on enables release tools, sync and webhooks
# While off, release tools/prompts are hidden, sync stops and webhooks answer 503.
# Enabling Jira also needs all three credentials below. Everything else works.
JIRA_BASE_URL=                    # https://your-site.atlassian.net
JIRA_EMAIL=                       # the bot user's login
JIRA_API_TOKEN=                   # https://id.atlassian.com/manage-profile/security/api-tokens
# The secret of the "Issue created" webhook pointing at https://<service>/webhooks/jira. Required:
# without it every webhook is rejected.
JIRA_WEBHOOK_SECRET=
# Issue types that get triaged.                                                      [RCI, MMT Risk]
JIRA_RCI_ISSUE_TYPE=RCI
JIRA_RISK_ISSUE_TYPE=MMT Risk
# Optional custom fields (for example customfield_10042). Unset fields are read from the ticket text.
JIRA_FIELD_CLIENT=
JIRA_FIELD_USER_EMAIL=
JIRA_FIELD_SCREEN=
JIRA_FIELD_OCCURRED_AT=
# Where ticket links in answers open.                                               [JIRA_BASE_URL]
JIRA_PUBLIC_URL=

# ------------------------------------------------------------------ Release outcomes
RELEASES_JIRA_PROJECT=ACP                                   # project whose fix versions are the releases
RELEASES_SUPPORT_JQL=project = SUP AND issuetype in ("RCI", "MMT Risk")
RELEASES_KEEP=12                                            # releases kept (1–52)
RELEASES_WINDOW_DAYS=30                                     # longest "after" window (7–120)
RELEASES_FISCAL_START_MONTH=1                               # 1 = calendar quarters, 4 = April, …
RELEASES_COMPONENT_SCREENS={}                               # Jira component → screen, e.g. {"Billing": "/invoices"}

# ------------------------------------------------------------------ This service
SERVICE_PORT=8080
# The address people use to open clip links (put HTTPS in front for anything public).
SERVICE_PUBLIC_URL=http://localhost:8080
# The System page in PostHog Lens reads the status page here (deploy/status). STATUS_PASSWORD only if
# that page has one.
STATUS_URL=http://127.0.0.1:8090
STATUS_PASSWORD=
# Bearer token for /mcp and /status. Long and random: openssl rand -hex 32
MCP_TOKEN=
# Signs clip links. Long and random.
CLIP_LINK_SECRET=
CLIP_LINK_TTL_HOURS=168
APP_NAME=PostHog Lens
APP_TAG=for ION
# SQLite file for clips, people, releases and verdicts.                            [run/triage.db]
TRIAGE_DB=

# ------------------------------------------------------------------ Clips
CLIP_RETENTION_DAYS=14            # unsaved clips are deleted after this
CLIPS_PER_HOUR=20                 # per person
AUDIT_RETENTION_DAYS=365
CLIP_OUT_DIR=                     # [clips/]
CLIP_CACHE_DIR=                   # [.cache/]
CLIP_CACHE_MAX_MB=2048
# Hosts a recording may load while it renders, on ports 80/443 (write host:port for another port).
# Everything else is refused by the renderer's allowlist proxy.  [localhost]
CLIP_ALLOWED_HOSTS=localhost
CHROME_HEADLESS_SHELL=            # path to chrome-headless-shell; empty uses the one pnpm install fetched

# ------------------------------------------------------------------ Session replay retention (optional)
# How many days of session replays PostHog keeps is set on Admin → Clips (off by default: nothing is
# deleted). See docs/replay-retention.md. Event data is never touched.
# A separate personal API key for this project only, with session_recording:write and project:read.
# Without it the daily job deletes nothing. The read-only POSTHOG_PERSONAL_API_KEY cannot delete.
LENS_REPLAY_RETENTION_API_KEY=
# 1: the daily job only logs and audits how many recordings it would delete.                     [off]
LENS_REPLAY_RETENTION_DRY_RUN=
# At most this many recordings are deleted a day; the rest wait for the next day.                [2000]
LENS_REPLAY_RETENTION_MAX_PER_RUN=2000
# Recordings listed and deleted per batch (1-500).                                               [100]
LENS_REPLAY_RETENTION_BATCH=100

# ------------------------------------------------------------------ Live page
LIVE_ACTIVE_GAP_S=60              # after each action, this many seconds count as active (the page can change it)
LIVE_NOW_MINUTES=5                # "in the app now" = an action within this many minutes
# Events that are not a person doing something, so they never count as actions. Comma-separated.
LIVE_IGNORE_EVENTS=$feature_flag_called,$set,$groupidentify,$web_vitals,$opt_in,survey shown,survey dismissed

# ------------------------------------------------------------------ Claude (optional)
# Lets the Jira automation read ticket text with Claude. Without it, rules are used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ------------------------------------------------------------------ Demo only
DEMO_APP_URL=http://localhost:3000
DEMO_APP_PORT=3000

# ------------------------------------------------------------------ Task history (Dashboards)
# The client task map and flow time read a task history Lens builds in the background from PostHog's
# events: every TASKS_INTERVAL_MINUTES it re-reads today and yesterday and catches up older days, newest
# first. A full Reval day (~110,000 events) is about 4 queries and 5 seconds.
# Dedicated ingestion worker old-generation heap limit in MiB (64–32768).                    [1536]
# TASKS_WORKER_MEMORY_MB=1536
# Separate SQLite file; relative paths resolve from the repository root.                       [run/tasks.db]
TASKS_DB=
TASKS_INTERVAL_MINUTES=10
# Older days caught up per run. 20 is about 80 queries a run, well inside PostHog's query limit
# (about 1,200 an hour), so the other tools keep working while a year is filled in (about 3 hours).  [20]
TASKS_BACKFILL_DAYS_PER_RUN=20
# Days of history kept. Dialog friction, top pains and workflows are answered from the same daily history
# (complete days, no sampling); at ~274,000 events a day, 400 days is about 3 GB of SQLite. Replay examples of
# single attempts (slowest attempts, client story links) are kept 30 days.
TASKS_HISTORY_DAYS=400
# Days the history has not processed yet (today, yesterday, unprocessed dates) are read live from PostHog.
# A live read larger than this many events is refused with a way forward instead of reading part of it.  [1000000]
# LENS_LIVE_MAX_EVENTS=1000000
# Client list for anonymisation and client names: every refresh reads only the last two days of events; a full
# 400-day scan runs once and then every this many days, in the background.                              [7]
# LENS_ROSTER_FULL_RESCAN_DAYS=7

# How many PostHog queries Lens runs at once (1-16, default 4). Lower on a very small ClickHouse.
# POSTHOG_CONNECTIONS=4

# Background pre-warm of the heaviest chat answers (default arguments), so the first question is instant.
# Minutes between rounds (0: off) and which tools. A round takes ~1.5 min on a small box.
# LENS_PREWARM_MINUTES=15
# LENS_PREWARM_TOOLS=reval_brief,top_pains,dialog_friction,client_signals,discover_workflows,message_doctor
# How long other chat answers are kept, in seconds (0: off).
# LENS_TOOL_CACHE_SECONDS=120

# Optional weekly client briefing delivery (off when URL is empty).
# Incoming webhook for Microsoft Teams or Slack. Keep this URL secret.
LENS_BRIEFING_WEBHOOK=
LENS_BRIEFING_WEBHOOK_KIND=teams   # teams or slack
LENS_BRIEFING_DAY=mon             # mon tue wed thu fri sat sun
LENS_BRIEFING_HOUR=8              # 0–23, UTC

# MCP invocation budgets: token buckets applied per token AND per user email across tokens.
# Heavy tools cost 5 units; other tools cost 1. No waiting/queueing when a budget is exhausted.
LENS_MCP_CALLS_PER_MINUTE=120   # an agent fanning out ~24 heavy calls at once fits; the hour budget still caps sustained use
LENS_MCP_CALLS_PER_HOUR=600
LENS_MCP_CONCURRENT_CALLS=4
# Tool audit metadata only (no arguments or result content); hourly pruning.
LENS_MCP_AUDIT_RETENTION_DAYS=90

# Exact rollup aggregation guards. Exhaustion falls back to exact live analytical jobs.
LENS_AGG_MAX_GROUPS=20000
LENS_AGG_MAX_DISTINCT=5000000
LENS_AGG_MAX_DAILY_DECOMPRESSED_BYTES=33554432
# Reusable analytical worker threads (separate from the PostHog HTTP query gate).
LENS_JOB_WORKERS=2
# Only analyses returned as handles count; fast synchronous answers bypass this per-user cap.
LENS_JOBS_PER_USER=4
# Global pending analytical jobs, in addition to active workers. Overflow returns busy.
LENS_JOB_QUEUE=64
# get_job_result waits for completion; capped at the 20-second synchronous budget.
LENS_JOB_POLL_WAIT_MS=15000
# Optional administrator-only raw error sink. Created/enforced mode 0600; credentials redacted.
# LENS_DEBUG_ERRORS_FILE=/private/admin/lens-errors.jsonl

# Replay clips have their own queue (separate from analytics jobs).
# Global concurrency is clamped to 1..8; per-person cap is at least 1.
LENS_CLIP_CONCURRENCY=5
LENS_CLIP_PER_USER=2
# MCP waits at most this many milliseconds before returning a clip-page link (1..55000).
LENS_CLIP_MCP_WAIT_MS=25000
# Idle Chromium default: min(2, LENS_CLIP_CONCURRENCY); explicit values are respected.
# MAX_IDLE_BROWSERS=2
# Peak Chromium memory is about concurrency x 250 MB, on top of the service.
