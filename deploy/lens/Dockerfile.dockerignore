# Only what the service needs goes into the image: no data, settings, logs or other deploy files.
.git
node_modules
.cache
clips
logs
run
.secrets.env
.mcp.json
*.log
# deploy/ stays out, except the status page, which runs from this image too (deploy/status/up.sh).
deploy/*
!deploy/status
deploy/status/status.env
demo-app
