# Only what the service needs goes into the image: no data, settings, logs or other deploy files.
.git
node_modules
.cache
clips
logs
run
.secrets.env
.mcp.json
*.log
# deploy/ stays out, except the status page, which runs from this image too (deploy/status/up.sh),
# and the survey engine files its tests need.
deploy/*
!deploy/status
deploy/status/status.env
# The survey engine's sources and fixture, for its tests (the service itself does not load them).
!deploy/posthog/survey-engine/engine.js
!deploy/posthog/survey-engine/build.mjs
!deploy/posthog/survey-engine/fixtures
demo-app
