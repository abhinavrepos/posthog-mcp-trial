# Lets the ticket-triage renderer's Chrome create user namespaces, so its sandbox works as a
# non-root user on Ubuntu 23.10+ (kernel.apparmor_restrict_unprivileged_userns=1). This is the
# approach Chromium documents and Ubuntu uses for Google Chrome. It covers only the Chrome
# binaries under /srv/ticket-triage/.cache/puppeteer.
#
#   sudo cp deploy/apparmor-ticket-triage-chrome /etc/apparmor.d/ticket-triage-chrome
#   sudo apparmor_parser -r /etc/apparmor.d/ticket-triage-chrome
abi <abi/4.0>,
include <tunables/global>

profile ticket-triage-chrome /srv/ticket-triage/.cache/puppeteer/*/linux-*/*/{chrome,chrome-headless-shell} flags=(unconfined) {
  userns,
  include if exists <local/ticket-triage-chrome>
}
