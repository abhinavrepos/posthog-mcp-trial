# Copy to status.env (git-ignored) and change what you need. Everything is optional.

# Who can open the page: 127.0.0.1 (this machine only) or 0.0.0.0 (everyone; needs STATUS_PASSWORD).
# The STATUS_BIND environment variable of up.sh wins over this.                         [127.0.0.1]
STATUS_BIND=127.0.0.1
# Asked for on the page (any user name). Required when STATUS_BIND is not 127.0.0.1.
STATUS_PASSWORD=
# Page title.
STATUS_TITLE=PostHog Lens status
# Compose projects whose containers are watched, comma-separated.                     [posthog]
STATUS_PROJECTS=posthog
# Seconds between checks.                                                                   [15]
STATUS_INTERVAL_SECONDS=15
# A problem when no event has arrived for this many minutes. Empty: never (quiet systems).
STATUS_MAX_EVENT_AGE_MINUTES=
# Endpoints to check, replacing the default list: group|name|url[|any], comma-separated. "any":
# any HTTP answer counts as up. Names on PostHog's network (web, capture...) and
# host.docker.internal (this machine) both work.
# Names must not contain commas.
# STATUS_HTTP=PostHog|Web|http://web:8000/_health,Lens|Triage service|http://host.docker.internal:8080/health
