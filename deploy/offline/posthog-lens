#!/usr/bin/env bash
# posthog-lens: the one command for running PostHog and PostHog Lens on a machine without internet.
# Installed as /usr/local/sbin/posthog-lens (root-owned) by "setup". The ops user gets sudo for this
# command only:
#
#   ph_ops ALL=(root) NOPASSWD: /usr/local/sbin/posthog-lens
#   ph_ops ALL=(root) NOPASSWD: /usr/local/sbin/posthog-lens *
#
#   sudo posthog-lens update <kit tag>   unpack that kit from ECR into the project folder, then install or
#                                        upgrade PostHog and PostHog Lens with it (no questions asked)
#   sudo posthog-lens status             what is installed, and whether PostHog and Lens answer
#   sudo posthog-lens doctor             PostHog Lens's full check of its settings and services
#   sudo posthog-lens check [minutes]    waits (10 by default) until PostHog, Lens and every status-page check
#                                        are fine, then says so in one line; otherwise says what is not
#   sudo posthog-lens alert-test         applies the status page's settings (status.env) and sends a test alert
#   sudo posthog-lens progress [-f]      the upgrade or install running now: step, time, last lines (-f: follow it)
#   sudo posthog-lens history            the last upgrades and installs: when, kit, how long, result
#   sudo posthog-lens restart            restart PostHog Lens
#   sudo posthog-lens cleanup            after an upgrade: delete its backup (asks about each item)
#   sudo posthog-lens rollback           after an upgrade: go back to the PostHog from before it
#
# The kit tag is the part after "posthog/kit:" that deploy/offline/build-images.sh prints at the end
# (for example 685049943753-92fb46e1); the full image name works too.
#
# One-time setup, by an admin, from a copy of this file (it copies itself into place):
#   sudo bash posthog-lens setup <kit tag>
# It writes /etc/posthog-lens/posthog-lens.env (the settings below, root-owned), creates the project
# folder (root-owned), moves PostHog Lens's settings and data there from an earlier project folder
# (OLD_DIR), installs /usr/local/sbin/posthog-lens and runs "update <kit tag>".
#
# Settings, in /etc/posthog-lens/posthog-lens.env (also the installer's answers, deploy/install.env.example):
#   LENS_DIR         the project folder                                        [/data04/posthog-lens]
#   POSTHOG_DIR      the PostHog install
#   IMAGE_SOURCE     local: the images were loaded onto this machine beforehand (Ubuntu without AWS:
#                    sudo docker load -i posthog-lens-images-<kit>.tar); registry: pulled from REGISTRY [registry]
#   REGISTRY, REGION where the images are       [555011114032.dkr.ecr.ca-central-1.amazonaws.com, ca-central-1]
#   MIGRATE_REPLAYS  copy old session replays during a PostHog upgrade (yes/no)                    [no]
#   SITE             this machine's folder in deploy/offline/sites, set by setup when one exists: its
#                    site.env is added here, and its docker-compose.site.yml goes to the PostHog folder
#   ALLOW_LIVE       1: a PostHog upgrade goes ahead while apps keep sending events
set -euo pipefail

CONF="${POSTHOG_LENS_CONF:-/etc/posthog-lens/posthog-lens.env}"   # POSTHOG_LENS_CONF, SBIN: for tests only
SBIN="${POSTHOG_LENS_SBIN:-/usr/local/sbin/posthog-lens}"
die() { echo "posthog-lens: $*" >&2; exit 1; }
say() { echo "==> $*"; }
[ "$(id -u)" = 0 ] || die "run it with sudo: sudo posthog-lens ${1:-status}"
# sudo resets PATH; the AWS CLI and Docker live in the usual places.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

conf() { grep -E "^$1=" "$CONF" 2>/dev/null | tail -1 | cut -d= -f2- | sed -E 's/^"(.*)"$/\1/' || true; }
load() {
    [ -f "$CONF" ] || die "$CONF is missing: run the one-time setup first (sudo bash posthog-lens setup <kit tag>)."
    LENS_DIR="$(conf LENS_DIR)"; LENS_DIR="${LENS_DIR:-/data04/posthog-lens}"
    POSTHOG_DIR="$(conf POSTHOG_DIR)"
    REGISTRY="$(conf REGISTRY)"; REGISTRY="${REGISTRY:-555011114032.dkr.ecr.ca-central-1.amazonaws.com}"
    REGION="$(conf REGION)"; REGION="${REGION:-ca-central-1}"
    # IMAGE_SOURCE=... in front changes it for good (kept in $CONF).
    if [ -n "${IMAGE_SOURCE:-}" ] && [ "$IMAGE_SOURCE" != "$(conf IMAGE_SOURCE)" ]; then
        case "$IMAGE_SOURCE" in local | registry) ;; *) die "IMAGE_SOURCE is local or registry, not \"$IMAGE_SOURCE\"." ;; esac
        sed -i '/^IMAGE_SOURCE=/d' "$CONF"; echo "IMAGE_SOURCE=$IMAGE_SOURCE" >>"$CONF"
    fi
    IMAGE_SOURCE="$(conf IMAGE_SOURCE)"; IMAGE_SOURCE="${IMAGE_SOURCE:-registry}"
    export IMAGE_SOURCE
    [ -n "$POSTHOG_DIR" ] || die "POSTHOG_DIR is not set in $CONF."
}

# A kit tag (685049943753-92fb46e1) or the full image name -> the full image name, from our registry only.
kit_image() {
    local t="${1:-}"
    t="${t#"$REGISTRY/posthog/kit:"}"; t="${t#lens-offline/posthog/kit:}"
    [[ "$t" =~ ^[0-9a-f]{12}-[0-9a-f]{8}$ ]] || die "\"${1:-}\" is not a kit tag. It looks like 685049943753-92fb46e1: the end of the kit name build-images.sh printed."
    if [ "$IMAGE_SOURCE" = local ]; then echo "lens-offline/posthog/kit:$t"; else echo "$REGISTRY/posthog/kit:$t"; fi
}

ecr_login() {
    local pw
    # A local registry (a rehearsal against localhost:5000) needs no login.
    case "$REGISTRY" in localhost:* | 127.0.0.1:*) return 0 ;; esac
    pw="$(aws ecr get-login-password --region "$REGION" 2>&1)" || die "cannot log in to $REGISTRY: $pw"
    docker login --username AWS --password-stdin "$REGISTRY" <<<"$pw" >/dev/null 2>&1 || die "docker login to $REGISTRY failed."
}

# A site's compose file, for this machine only, kept through upgrades by EXTRA_COMPOSE_FILES.
site_check() {
    local site; site="$(conf SITE)"
    [ -z "$site" ] || [ "$site" = "$(hostname -s)" ] || die "$CONF is for $site, but this machine is $(hostname -s)."
}
site_files() {
    local site extra env="$POSTHOG_DIR/.env" name=docker-compose.site.yml; site="$(conf SITE)"
    [ -n "$site" ] || return 0
    [ -f "$LENS_DIR/deploy/offline/sites/$site/$name" ] || die "this kit has no deploy/offline/sites/$site/$name."
    install -o root -g root -m 644 "$LENS_DIR/deploy/offline/sites/$site/$name" "$POSTHOG_DIR/$name"
    extra="$(grep -E '^EXTRA_COMPOSE_FILES=' "$env" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '"' || true)"
    case ":$extra:" in
        *":$name:"*) ;;
        *) sed -i '/^EXTRA_COMPOSE_FILES=/d' "$env"; echo "EXTRA_COMPOSE_FILES=${extra:+$extra:}$name" >>"$env" ;;
    esac
}

update() {
    local image; image="$(kit_image "${1:-}")"
    site_check
    mkdir -p "$LENS_DIR"
    chown root:root "$LENS_DIR"; chmod 755 "$LENS_DIR"
    if [ "$IMAGE_SOURCE" = local ]; then
        docker image inspect "$image" >/dev/null 2>&1 || die "$image is not on this machine. Load the images file for it first: sudo docker load -i posthog-lens-images-${image##*:}.tar"
        say "unpacking $image into $LENS_DIR"
    else
        say "logging in to $REGISTRY"
        ecr_login
        say "unpacking $image into $LENS_DIR"
        docker pull -q "$image" >/dev/null || die "cannot pull $image (is the tag right?)."
    fi
    docker run --rm -v "$LENS_DIR:/out" "$image"
    # This command comes with the kit too, so a fix to it reaches the machine with the update.
    install -o root -g root -m 755 "$LENS_DIR/deploy/offline/posthog-lens" "$SBIN"
    site_files
    export ALLOW_LIVE="${ALLOW_LIVE:-$(conf ALLOW_LIVE)}"
    # A kit for another PostHog version: PostHog is upgraded first (deploy/migrate/posthog-upgrade.sh,
    # backup first), through the installer's posthog step.
    local want have
    want="$(bash -c '. "$1" >/dev/null 2>&1; echo "$TARGET_COMMIT"' _ "$LENS_DIR/deploy/migrate/versions/versions.env")"
    have="$(git -C "$POSTHOG_DIR/posthog" rev-parse HEAD 2>/dev/null || true)"
    # A PostHog with no .git in its source, or a machine with no git yet.
    have="${have:-$(grep -E '^POSTHOG_APP_TAG=' "$POSTHOG_DIR/.env" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '"' || true)}"
    if [ -n "$have" ] && [ -n "$want" ] && [ "$have" != "$want" ]; then
        # A finished upgrade's backup is the way back from it: it goes first, by hand. After a rollback, or an
        # upgrade that stopped, the backup belongs to this attempt, which carries on with it.
        if [ -f "$POSTHOG_DIR/upgrade-state/done/verify" ]; then
            if [ -n "$(ls -A "$POSTHOG_DIR/upgrade-backup" 2>/dev/null)" ]; then
                die "this kit upgrades PostHog (${have:0:12} -> ${want:0:12}), but the last upgrade's backup is still in $POSTHOG_DIR/upgrade-backup. Once you no longer need it: sudo posthog-lens cleanup, then run this again."
            fi
            mv "$POSTHOG_DIR/upgrade-state" "$POSTHOG_DIR/upgrade-state.${have:0:12}.$(date -u +%Y%m%d%H%M)"
        fi
        rm -f "${INSTALL_STATE_DIR:-/var/lib/posthog-lens-install}"/{done/posthog,posthog-started}
        say "PostHog ${have:0:12} -> ${want:0:12}: it is upgraded first (full backup, then the migrations; PostHog is down meanwhile)"
    fi
    say "installing / upgrading (answers from $CONF)"
    cd "$LENS_DIR"
    POSTHOG_DIR="$POSTHOG_DIR" bash deploy/install.sh --config "$CONF" --yes
}

status() {
    echo "project folder  $LENS_DIR"
    echo "PostHog folder  $POSTHOG_DIR"
    if [ -f "$LENS_DIR/deploy/offline/ecr.env" ]; then
        echo "kit             commit $(conf_of "$LENS_DIR/deploy/offline/ecr.env" IMAGES_COMMIT | cut -c1-12), images pushed $(conf_of "$LENS_DIR/deploy/offline/ecr.env" IMAGES_PUSHED)"
    fi
    echo "PostHog         $(curl -s -o /dev/null -m 5 -w '%{http_code}' http://localhost/_health | sed 's/^200$/answering (200)/')"
    local port; port="$(conf_of "$LENS_DIR/.secrets.env" SERVICE_PORT)"; port="${port:-8080}"
    echo "PostHog Lens    $(curl -s -o /dev/null -m 5 -w '%{http_code}' "http://localhost:$port/healthz" | sed 's/^200$/answering (200)/'), $(systemctl is-active ticket-triage 2>/dev/null || true)"
    echo
    [ -x "$LENS_DIR/deploy/install.sh" ] && bash "$LENS_DIR/deploy/install.sh" status | sed -n '1,20p' || true
}
# Waits until PostHog and Lens answer and the status page has no problem left, then one verdict line.
check() {
    local mins="${1:-}" port spass sport ph lens st end up
    # Right after a boot PostHog checks its ~1,000 migrations before it answers: 10-15 minutes on 4 CPUs.
    up="$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 9999)"
    [ -n "$mins" ] || { [ "$up" -lt 1800 ] && mins=25 || mins=10; }
    [[ "$mins" =~ ^[0-9]+$ ]] || die "usage: sudo posthog-lens check [minutes]"
    mins=$((10#$mins))
    port="$(conf_of "$LENS_DIR/.secrets.env" SERVICE_PORT)"; port="${port:-8080}"
    spass="$(conf_of "$LENS_DIR/deploy/status/status.env" STATUS_PASSWORD)"; sport="${STATUS_PORT:-8090}"
    end=$((SECONDS + mins * 60))
    say "checking PostHog, PostHog Lens and the status page (waiting up to $mins min while they start)"
    [ "$up" -lt 1800 ] && [ -z "${1:-}" ] && echo "    This machine started $((up / 60)) min ago; PostHog takes 10-20 min to answer after a boot."
    while :; do
        ph="$(curl -s -o /dev/null -m 5 -w '%{http_code}' http://localhost/_health || true)"
        lens="$(curl -s -o /dev/null -m 5 -w '%{http_code}' "http://localhost:$port/healthz" || true)"
        st="$(curl -s -m 5 "http://127.0.0.1:$sport/healthz" || true)"
        [ "$ph" = 200 ] && [ "$lens" = 200 ] && [ "$st" = ok ] && break
        if [ $SECONDS -ge $end ]; then
            echo "NOT READY after $mins min:"
            [ "$ph" = 200 ] || echo "    PostHog does not answer (http://localhost/_health: ${ph:-no answer})"
            [ "$lens" = 200 ] || echo "    PostHog Lens does not answer (port $port: ${lens:-no answer}); see: journalctl -u ticket-triage -n 50"
            if [ "$st" != ok ]; then
                curl -s -m 5 ${spass:+-u "x:$spass"} "http://127.0.0.1:$sport/api/status" 2>/dev/null | python3 -c '
import json, sys
try: d = json.load(sys.stdin)
except Exception: print("    the status page does not answer (port '"$sport"'): sudo docker ps | grep lens-status"); sys.exit()
for r in d["checks"]:
    if r["level"] in ("down", "warn"): print("    %-5s %s: %s (%s)" % (r["level"], r["group"], r["name"], r.get("detail", "")))' || true
            fi
            return 1
        fi
        sleep 10
    done
    local warns; warns="$(curl -s -m 5 ${spass:+-u "x:$spass"} "http://127.0.0.1:$sport/api/status" 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("warn", 0))' 2>/dev/null || echo 0)"
    echo "READY: PostHog, PostHog Lens and every status-page check are fine$([ "${warns:-0}" != 0 ] && echo " ($warns warning(s) on the status page: http://127.0.0.1:$sport)")."
}

alert_test() {
    local d="$LENS_DIR/deploy/status" id
    grep -qE '^STATUS_ALERT_WEBHOOK=.+' "$d/status.env" 2>/dev/null || die "no alert address yet: add STATUS_ALERT_WEBHOOK=<a Teams or Slack webhook URL> to $d/status.env, then run this again."
    say "starting the status page again with $d/status.env"
    STATUS_DISK_FOLDER="$d/.disk" POSTHOG_NETWORK="$(basename "$POSTHOG_DIR")_default" bash "$d/up.sh" >/dev/null
    id="$(docker ps -q -f label=com.docker.compose.project=lens-status -f label=com.docker.compose.service=status | head -1)"
    [ -n "$id" ] || die "the status page is not running: sudo docker ps -a | grep lens-status"
    docker exec "$id" node server.mjs test-alert
}
# Upgrades and installs run in the background (upgrade.sh, fresh-install.sh) and leave a trace here.
RUNS=/var/lib/posthog-lens/runs
progress() {
    local follow=0; [ "${1:-}" = -f ] && follow=1
    # One snapshot of the run (it may end at any moment): id, log, and a summary to print.
    local snap; snap="$(python3 /dev/fd/3 "$RUNS/current.json" 3<<'PY'
import json, sys, datetime as dt
try:
    r = json.load(open(sys.argv[1]))
except (FileNotFoundError, ValueError):
    sys.exit(0)
now = dt.datetime.now(dt.timezone.utc)
start = dt.datetime.fromisoformat(r["started"].replace("Z", "+00:00"))
upd = dt.datetime.fromisoformat(r["updated"].replace("Z", "+00:00"))
mins = int((now - start).total_seconds() // 60)
stale = (now - upd).total_seconds() > 90
print(r["id"]); print(r["log"])
print("%s of kit %s: running for %d min%s" % (r["kind"], r.get("kit") or "?", mins, "  (no sign of life for over 90 s: it may have stopped; run the same command again to continue)" if stale else ""))
print("  now:  %s" % (r.get("step") or "starting"))
if r.get("detail"): print("        %s" % r["detail"])
print("  log:  %s" % r["log"])
PY
)"
    if [ -z "$snap" ]; then
        echo "Nothing is running."
        [ -s "$RUNS/history.jsonl" ] && { echo "Last run:"; history 1; }
        return 0
    fi
    local id log; id="$(sed -n 1p <<<"$snap")"; log="$(sed -n 2p <<<"$snap")"
    sed -n '3,$p' <<<"$snap"
    if [ $follow = 0 ]; then echo; tail -n 12 "$log" 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g'; return 0; fi
    echo; local tp=''
    trap '[ -n "$tp" ] && kill "$tp" 2>/dev/null; echo; echo "Stopped following; the run carries on."; exit 0' INT
    tail -n 20 -F "$log" 2>/dev/null & tp=$!
    # Until this run (by id) is no longer the current one.
    while grep -qF "\"id\": \"$id\"" "$RUNS/current.json" 2>/dev/null; do sleep 2; done
    sleep 1; kill "$tp" 2>/dev/null || true; wait "$tp" 2>/dev/null || true; echo
    local line; line="$(grep -F "\"id\": \"$id\"" "$RUNS/history.jsonl" 2>/dev/null | tail -1)"
    history 1
    [ -n "$line" ] || { echo "The run stopped without recording a result (see $log)."; return 1; }
    return "$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("code", 1))' "$line")"
}
history() {
    local n="${1:-10}"
    [ -s "$RUNS/history.jsonl" ] || { echo "No upgrades or installs recorded yet."; return 0; }
    tail -n "$n" "$RUNS/history.jsonl" | python3 /dev/fd/3 3<<'PY'
import json, sys
rows = [json.loads(l) for l in sys.stdin if l.strip()]
for r in reversed(rows):
    m, sec = divmod(int(r.get("seconds", 0)), 60)
    print("%s UTC  %-13s kit %-12s  %3d min %02d s  %s" % (r["started"][:16].replace("T", " "), r["kind"], (r.get("kit") or "?")[:12], m, sec, r["result"].replace("_", " ")))
    if r["result"] != "ready":
        print("    stopped at: %s  log: %s" % (r.get("step") or "?", r.get("log")))
PY
}
conf_of() { grep -E "^$2=" "$1" 2>/dev/null | tail -1 | cut -d= -f2- || true; }

setup() {
    local tag="${1:-}" old="${OLD_DIR:-/data04/ph_ops/posthog-mcp-trial}" self
    [ -n "$tag" ] || die "usage: sudo bash posthog-lens setup <kit tag>"
    [[ "${tag##*:}" =~ ^[0-9a-f]{12}-[0-9a-f]{8}$ ]] || die "\"$tag\" is not a kit tag. It looks like 685049943753-92fb46e1: the end of the kit name build-images.sh printed."
    self="$(readlink -f "$0")"
    # Settings: kept when they exist; otherwise from the earlier install's answers where it has them.
    mkdir -p "$(dirname "$CONF")"; chmod 755 "$(dirname "$CONF")"
    if [ ! -f "$CONF" ]; then
        local ph site; ph="${POSTHOG_DIR:-$(grep -E '^POSTHOG_DIR=' "${INSTALL_STATE_DIR:-/var/lib/posthog-lens-install}/install.env" 2>/dev/null | tail -1 | cut -d= -f2-)}"
        [ -n "$ph" ] || die "where is PostHog installed? Run: sudo POSTHOG_DIR=/data04/<posthog folder> bash posthog-lens setup $tag"
        umask 077            # settings can hold keys and passwords (site.env, the installer's answers)
        cat >"$CONF" <<EOF
# posthog-lens settings, and the answers deploy/install.sh uses (deploy/install.env.example lists them all).
LENS_DIR=${LENS_DIR:-/data04/posthog-lens}
POSTHOG_DIR=$ph
REGISTRY=${REGISTRY:-555011114032.dkr.ecr.ca-central-1.amazonaws.com}
REGION=${REGION:-ca-central-1}
IMAGE_SOURCE=${IMAGE_SOURCE:-registry}
MIGRATE_REPLAYS=no
EOF
        site="$(hostname -s)"
        if [ -f "$(dirname "$self")/sites/$site/site.env" ]; then
            { echo "SITE=$site"; grep -vE '^#' "$(dirname "$self")/sites/$site/site.env"; } >>"$CONF"
            say "settings for $site added"
        fi
        chown root:root "$CONF"; chmod 600 "$CONF"
        say "wrote $CONF"
    else
        say "keeping $CONF"
    fi
    load
    # The command itself, root-owned.
    install -o root -g root -m 755 "$self" "$SBIN"
    say "installed $SBIN"
    # PostHog Lens's settings and data from the earlier project folder, unless the new one has them.
    mkdir -p "$LENS_DIR"; chown root:root "$LENS_DIR"; chmod 755 "$LENS_DIR"
    if [ -d "$old" ] && [ "$(readlink -f "$old")" != "$(readlink -f "$LENS_DIR")" ] && [ ! -f "$LENS_DIR/.secrets.env" ]; then
        local f
        # .secrets.env last: once it is there, the copy finished, so a setup that stopped copies again.
        for f in .mcp.json run clips config logs .secrets.env; do
            if [ -e "$old/$f" ]; then cp -a "$old/$f" "$LENS_DIR/"; fi
        done
        say "copied PostHog Lens's settings and data from $old (it stays there; delete it once the new folder works)"
    fi
    update "$tag"
    echo
    say "done. From now on: sudo posthog-lens update <kit tag> | status | doctor | restart | cleanup | rollback"
}

cmd="${1:-}"; shift || true
case "$cmd" in
    setup) setup "$@" ;;
    update) load; update "$@" ;;
    status) load; status ;;
    check) load; check "$@" ;;
    alert-test) load; alert_test ;;
    progress) progress "$@" ;;
    history) history "$@" ;;
    doctor) load; exec bash "$LENS_DIR/deploy/lens/lens.sh" doctor ;;
    restart) systemctl restart ticket-triage && say "PostHog Lens restarted" ;;
    cleanup) load; POSTHOG_DIR="$POSTHOG_DIR" exec bash "$LENS_DIR/deploy/migrate/posthog-upgrade.sh" cleanup ;;
    rollback) load; POSTHOG_DIR="$POSTHOG_DIR" exec bash "$LENS_DIR/deploy/migrate/posthog-upgrade.sh" rollback ;;
    *) sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
