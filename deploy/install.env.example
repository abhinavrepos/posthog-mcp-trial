# Settings for deploy/install.sh. Copy this file, fill in what you want to change, then:
#   sudo deploy/install.sh --config my-install.env          # asks POSTHOG_ADDRESS and ADMIN_EMAIL if empty
#   sudo deploy/install.sh --config my-install.env --yes    # asks nothing (ADMIN_EMAIL must be set)
# Without --config the installer asks only POSTHOG_ADDRESS and ADMIN_EMAIL. Every other setting
# takes the default shown here. Your answers are kept (in /var/lib/posthog-lens-install/install.env),
# and a later run uses them again. Keep the filled-in file private: it holds keys.

# ================================================================ PostHog
# The address(es) people use to reach PostHog, comma-separated. The first is the main one (links in
# emails and exports use it). PostHog answers on all of them, and each one is trusted for logins
# (CSRF). A domain (posthog.example.com) gets HTTPS with a Let's Encrypt certificate: point its DNS A
# record at the instance's Elastic IP first and open ports 80 and 443 in its security group. An IP
# address, or http://name, runs plain HTTP: only on a private network or VPN. Don't mix the two
# kinds. Example: 10.0.1.25,52.1.2.3                       (asked) [the instance's public IP]
POSTHOG_ADDRESS=
# The first PostHog login (the installer makes up a password and tells you where it is).   (asked)
ADMIN_EMAIL=
# The organization created with that login.                                                  [ION]
ORG_NAME=
# Optional. Empty: PostHog records sessions on every site that sends events. Set, it records only on
# these addresses. Example: https://app.example.com,https://staging.example.com
APP_URLS=

# Only when this machine already runs an older PostHog, which the installer then upgrades: copy its
# session replays to the new version now (yes), or leave them in the old storage (no: the new version
# lists them but cannot play them until deploy/migrate/posthog-upgrade.sh replays copies them). (asked)
MIGRATE_REPLAYS=yes

# ================================================================ Your events
# The names your app uses when it sends events to PostHog. See "Your app" in the summary at the end.
PROP_CLIENT_ID=client_id          # event property with the client (customer account) id
PROP_CLIENT_NAME=client_name      # event property with the client's display name
PROP_APP_VERSION=app_version      # event property with the release, e.g. 26.10.0 ("none": dates only)
PROP_PERSON_EMAIL=email           # person property with the user's email
# Your app's screens, so a ticket that says "the invoices page" finds /invoices. A JSON file shaped
# like config/screens.example.json. Absolute path, or relative to the project folder. Empty: pages
# are matched by their path only.
SCREENS_FILE=

# ================================================================ Jira (optional: leave empty to connect later)
# Without these, Jira webhooks answer 503 and release outcomes stay empty. Everything else works.
# To connect later: set them in .secrets.env, then  sudo systemctl restart ticket-triage
JIRA_BASE_URL=                    # https://your-site.atlassian.net
JIRA_EMAIL=                       # the bot user's login
JIRA_API_TOKEN=                   # https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_RCI_ISSUE_TYPE=RCI           # issue types that get triaged
JIRA_RISK_ISSUE_TYPE=MMT Risk
RELEASES_JIRA_PROJECT=            # project key whose fix versions are your releases, e.g. ACP
RELEASES_SUPPORT_JQL=             # which tickets count as support tickets. Default:
                                  #   project = SUP AND issuetype in ("RCI", "MMT Risk")

# ================================================================ Claude
# Lets the Jira automation read ticket text with Claude. Empty: keyword rules are used.
ANTHROPIC_API_KEY=

# ================================================================ MCP servers Claude gets (on/off)
# This project's tools: replay links, tickets, clients, screens, releases.                     [on]
FEATURE_LENS_MCP=on
# PostHog's own MCP server (SQL, insights, flags, dashboards...).                              [on]
# With POSTHOG_MCP_URL empty, the installer runs it on this machine (deploy/posthog-mcp, port 8787,
# reachable from this machine only) and makes its key itself: read-only, this project only, without
# any session replay scope, so Claude can never reach replays.
FEATURE_POSTHOG_MCP=on
# Optional: another PostHog MCP server instead, and a personal key for it WITHOUT any
# session_recording scope.
POSTHOG_MCP_URL=
POSTHOG_MCP_API_KEY=

# ================================================================ This service
# Where people open clip links and Claude reaches /mcp. Put HTTPS in front before sharing it outside a
# private network.                                                  [http://<POSTHOG_ADDRESS>:8080]
SERVICE_PUBLIC_URL=
# Hosts a recording may load while it renders (your app's own hosts, its CDN). Everything else is
# blocked. Comma-separated.                        [the hosts in APP_URLS, or localhost without them]
CLIP_ALLOWED_HOSTS=

# ================================================================ Status page
# no: only on this machine (open it through an SSH tunnel). yes: on port 8090 for everyone, behind a
# password.                                                                                   [no]
STATUS_PUBLIC=no
# The page's password when STATUS_PUBLIC=yes. Empty: one is made up.
STATUS_PASSWORD=

# ================================================================ Rarely changed
# Where PostHog is installed.                                                       [/opt/posthog]
# POSTHOG_DIR=/opt/posthog
# Tunes PostHog for about 200 events a second (deploy/posthog/scale.sh). no: the plain hobby setup.
# SCALE=yes
# Any other setting from .env.example (APP_NAME, CLIP_RETENTION_DAYS, JIRA_FIELD_CLIENT, ...) can be
# added here too: it is copied into .secrets.env as it is.
